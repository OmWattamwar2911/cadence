# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wallet_db
DB_USERNAME=wallet_user
DB_PASSWORD=wallet_password

# JWT Security
# Must be at least 256 bits (32 bytes) hex or base64 encoded string
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000

# Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Fraud Prevention & Business Limits (Amounts in Paise / Minor Units: 100 paise = ₹1)
# 100,000 INR = 10,000,000 paise
FRAUD_MAX_AMOUNT_PER_TRANSFER=10000000
FRAUD_VELOCITY_MAX_TRANSFERS=5
FRAUD_VELOCITY_WINDOW_MINUTES=5

# Rate Limiting (Bucket4j)
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_TOKENS=5
RATE_LIMIT_LOGIN_REFILL_DURATION_SECONDS=60

RATE_LIMIT_TRANSFER_CAPACITY=10
RATE_LIMIT_TRANSFER_REFILL_TOKENS=10
RATE_LIMIT_TRANSFER_REFILL_DURATION_SECONDS=60
